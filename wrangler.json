{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ridemyway",
  "main": "apps/worker/index.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/",
      "/fr",
      "/fr/*",
      "/rides/*",
      "/how-it-works",
      "/drivers",
      "/safety",
      "/faq",
      "/search",
      "/my-trips",
      "/my-listings",
      "/saved",
      "/cart",
      "/join",
      "/login",
      "/trip-share",
      "/robots.txt",
      "/sitemap.xml",
      "/offer-a-ride",
      "/driver-verification",
      "/account",
      "/profile",
      "/help",
      "/policies",
      "/notifications",
      "/messages",
      "/operator"
    ],
    "html_handling": "drop-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ridemyway",
      "migrations_dir": "migrations",
      "database_id": "68ba6751-3f4e-43ee-849e-7b9af7cdc68d"
    }
  ],
  "preview_urls": false,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "SUPPORT_EMAIL": "support@ridely.ca",
    "RIDELY_PUBLIC_URL": "https://ridely.ca",
    "EMAIL_FROM": "Ridely <no-reply@ridely.ca>",
    "PILOT_SUPPORT_24_7": "true"
  },
  "routes": [
    {
      "pattern": "ridely.ca",
      "custom_domain": true
    },
    {
      "pattern": "www.ridely.ca",
      "custom_domain": true
    }
  ]
}
