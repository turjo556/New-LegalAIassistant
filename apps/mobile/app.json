{
  "expo": {
    "name": "RideMyWay",
    "slug": "ridemyway",
    "scheme": "ridemyway",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ridemyway.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ridemyway.app"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "splash": {
      "backgroundColor": "#0b1d3b"
    },
    "icon": "./assets/icon.png"
  }
}
